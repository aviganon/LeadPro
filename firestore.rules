rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ========== HELPER FUNCTIONS ==========

    function isAuth() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuth() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function validUserWrite() {
      let allowed = ['name', 'email', 'updatedAt'];
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowed);
    }

    // ========== USERS ==========

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuth() && request.auth.uid == userId;
      allow update: if (isOwner(userId) && validUserWrite()) || isAdmin();
      allow delete: if isAdmin();
    }

    // ========== LEARNING CONTENT ==========
    // Content is public (no login gate) — read by anyone. Writes only by admin.

    match /institutions/{id} { allow read: if true; allow write: if isAdmin(); }
    match /departments/{id}   { allow read: if true; allow write: if isAdmin(); }
    match /subjects/{id}  { allow read: if true; allow write: if isAdmin(); }
    match /topics/{id}    { allow read: if true; allow write: if isAdmin(); }
    match /questions/{id} { allow read: if true; allow write: if isAdmin(); }
    match /games/{id}     { allow read: if true; allow write: if isAdmin(); }
    match /materials/{id} { allow read: if true; allow write: if isAdmin(); }

    // ========== PROGRESS (logged-in users) ==========
    // Doc id is `${userId}_${subjectId}` — owner-scoped.

    match /progress/{progressId} {
      allow read, write: if isAuth() &&
        request.auth.uid == progressId.split('_')[0];
    }

    // ========== LEADERBOARD ==========
    // קריאה ציבורית (להצגת הטבלה). כתיבה רק דרך השרת (Admin SDK) — שומר ניקוד מרבי ומונע זיוף.
    match /leaderboard/{id} {
      allow read: if true;
      allow write: if false;
    }

    // ========== PRESENCE (online now) ==========
    // נכתב רק ע"י השרת (Admin SDK). קריאה לאדמין בלבד (להצגת "מחוברים עכשיו").
    match /presence/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ========== AI USAGE (cost tracking) ==========
    // נכתב רק ע"י השרת (Admin SDK עוקף חוקים). הלקוח לא יכול לכתוב; קריאה רק לאדמין.
    match /ai_usage/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ========== QUESTION REPORTS (דיווחי שאלות) ==========
    // נכתב רק ע"י השרת (Admin SDK) דרך /api/report-question. קריאה לאדמין בלבד.
    match /question_reports/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ========== SYSTEM CONFIG ==========

    match /system_config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
